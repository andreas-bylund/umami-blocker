{
  "manifest_version": 3,
  "name": "Umami Blocker",
  "version": "1.0.0",
  "description": "Blocks Umami analytics at the network level, so your own visits never show up in your stats.",
  "homepage_url": "https://github.com/andreas-bylund/umami-blocker",
  "permissions": ["declarativeNetRequest", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Umami Blocker"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
